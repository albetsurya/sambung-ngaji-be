# App
APP_ENV=development
APP_PORT=8080

# Database (direct connection port 5432 untuk supabase db push; sslmode=require otomatis untuk host remote)
DATABASE_URL=postgresql://user:***@host:5432/db

# Auth (wajib di semua env)
JWT_SECRET=ganti-random
JWT_EXPIRY_HOURS=12

# CORS (koma-separated; harus mencakup domain frontend produksi)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Webhook / cron (wajib di-set di production; kosong = endpoint fail-closed)
WA_VERIFY_TOKEN=
CRON_SECRET=

# AI Providers (semua gratis, fallback otomatis groq -> cerebras -> openrouter)
# Groq: https://console.groq.com (free tier, cepat)
# Cerebras: https://cloud.cerebras.ai (free tier, tercepat)
# OpenRouter: https://openrouter.ai (model :free, tanpa kartu kredit)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=member-photos