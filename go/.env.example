# App
APP_ENV=development
APP_PORT=8080

# Database (direct connection port 5432 untuk supabase db push; sslmode=require otomatis untuk host remote)
DATABASE_URL=postgresql://user:***@host:5432/db

# Auth (wajib di semua env)
JWT_SECRET=ganti-random
JWT_EXPIRY_HOURS=12

# CORS (koma-separated; harus mencakup domain frontend produksi)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Webhook / cron (wajib di-set di production; kosong = endpoint fail-closed)
WA_VERIFY_TOKEN=
CRON_SECRET=

# AI Providers (Gemini utama, Groq + Nvidia fallback — ketiganya gratis)
# Tiap provider coba daftar model berurutan sampai ada yang sukses.
# Bentuk list koma (MODELS) atau tunggal (MODEL, backward-compat).
# Gemini: https://aistudio.google.com/apikey
# Groq: https://console.groq.com
# Nvidia: https://build.nvidia.com/settings
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-pro
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
NVIDIA_API_KEY=
NVIDIA_MODELS=openai/gpt-oss-20b

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=member-photos